{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.rn-devtools-hub/rn-devtools-hub",
  "title": "rn-devtools-hub",
  "description": "Drive a running React Native or Expo app from inside its JS runtime: see, act, prove.",
  "version": "0.12.2",
  "websiteUrl": "https://rn-devtools-hub.github.io/rn-devtools-hub/",
  "repository": {
    "url": "https://github.com/rn-devtools-hub/rn-devtools-hub",
    "source": "github"
  },
  "packages": [
    {
      "registryType": "npm",
      "registryBaseUrl": "https://registry.npmjs.org",
      "identifier": "rn-devtools-hub",
      "version": "0.12.2",
      "runtimeHint": "npx",
      "packageArguments": [
        {
          "type": "positional",
          "value": "mcp",
          "valueHint": "mcp",
          "description": "Speak MCP over stdio, bridging to the local hub and starting it if needed"
        }
      ],
      "transport": {
        "type": "stdio"
      }
    },
    {
      "registryType": "npm",
      "registryBaseUrl": "https://registry.npmjs.org",
      "identifier": "rn-devtools-hub",
      "version": "0.12.2",
      "transport": {
        "type": "streamable-http",
        "url": "http://127.0.0.1:8973/mcp"
      }
    }
  ]
}
